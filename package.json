{
  "name": "@nairaramp/core",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "cross-env RUN_INTEGRATION=1 vitest run test/integration"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.4.0",
    "@stellar/typescript-wallet-sdk": "6.0.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": "2.8.0",
    "@stellar/freighter-api": "6.0.1"
  },
  "peerDependenciesMeta": {
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    },
    "@stellar/freighter-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "2.8.0",
    "@stellar/freighter-api": "6.0.1",
    "@types/node": "26.6.6",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "tsup": "9.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
